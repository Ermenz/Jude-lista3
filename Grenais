inter = 0
gremio = 0
empate = 0
total = 0

while True:
    i, g = map(int, input().split())

    total += 1

    if i > g:
        inter += 1
    elif g > i:
        gremio += 1
    else:
        empate += 1

    print("Novo grenal (1-sim 2-nao)")
    x = int(input())

    if x == 2:
        break

print(f"{total} grenais")
print(f"Inter:{inter}")
print(f"Gremio:{gremio}")
print(f"Empates:{empate}")

if inter > gremio:
    print("Inter venceu mais")
elif gremio > inter:
    print("Gremio venceu mais")
else:
    print("Nao houve vencedor")
